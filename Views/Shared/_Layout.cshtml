    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <script>
            const vapidPublicKey = "BI2kjeO75SlWcv0jL-b1LyG10JVBbyr_xtEUCHKHmYhLKSLMTWYjhiRYkdMj65cv2POQMhYbmabWJZVCFNj6ecs";

            async function initWebPush() {
                if (!('serviceWorker' in navigator) || !('PushManager' in window)) return;

                try {
                    const registration = await navigator.serviceWorker.register('/sw.js');

                    const permission = await Notification.requestPermission();
                    if (permission !== 'granted') return;

                    const subscription = await registration.pushManager.subscribe({
                        userVisibleOnly: true,
                        applicationServerKey: urlBase64ToUint8Array(vapidPublicKey)
                    });

                    const subJson = subscription.toJSON();
                    await fetch('/Chat/SavePushSubscription', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            endpoint: subJson.endpoint,
                            p256dh: subJson.keys.p256dh,
                            auth: subJson.keys.auth
                        })
                    });
                } catch (err) {
                    console.error('Web Push registration failed:', err);
                }
            }

            function urlBase64ToUint8Array(base64String) {
                const padding = '='.repeat((4 - base64String.length % 4) % 4);
                const base64 = (base64String + padding)
                    .replace(/\-/g, '+')
                    .replace(/_/g, '/');

                const rawData = window.atob(base64);
                const outputArray = new Uint8Array(rawData.length);

                for (let i = 0; i < rawData.length; ++i) {
                    outputArray[i] = rawData.charCodeAt(i);
                }
                return outputArray;
            }

            initWebPush();
        </script>

        <!-- Call Overlay -->
        <div class="call-overlay" id="incomingCallOverlay" style="display:none;">
            <div class="call-popup incoming">
                <div class="call-pulsing-icon">
                    <i class="fas fa-phone call-ring-icon"></i>
                </div>
                <div class="call-avatar" id="incomingCallAvatar">
                    <span id="incomingCallInitial">?</span>
                </div>
                <div class="call-name" id="incomingCallName">Calling...</div>
                <div class="call-type-label" id="incomingCallType">Incoming voice call</div>
                <div class="call-actions">
                    <button class="call-btn call-btn-decline" onclick="declineCall()">
                        <i class="fas fa-phone-slash"></i>
                    </button>
                    <button class="call-btn call-btn-accept" onclick="acceptCall()">
                        <i class="fas fa-phone"></i>
                    </button>
                </div>
            </div>
        </div>
        <!-- Active Call Screen -->
        <div class="call-overlay" id="activeCallOverlay" style="display:none;">
            <div class="call-screen">
                <div class="call-video-container">
                    <video id="remoteVideo" autoplay playsinline></video>
                    <video id="localVideo" autoplay playsinline muted></video>
                </div>
                <div class="call-info">
                    <div class="call-name-large" id="activeCallName">User</div>
                    <div class="call-duration" id="callDuration">00:00</div>
                </div>
                <div class="call-controls">
                    <button class="call-ctrl-btn" id="callMuteBtn" onclick="toggleMute()">
                        <i class="fas fa-microphone"></i>
                    </button>
                    <button class="call-ctrl-btn" id="callVideoBtn" onclick="toggleVideo()">
                        <i class="fas fa-video"></i>
                    </button>
                    <button class="call-ctrl-btn call-ctrl-btn-danger" onclick="endCall()">
                        <i class="fas fa-phone-slash"></i>
                    </button>
                    <button class="call-ctrl-btn" id="callSpeakerBtn" onclick="toggleSpeaker()">
                        <i class="fas fa-volume-up"></i>
                    </button>
                </div>
            </div>
        </div>

        <style>
    /* ===== Call UI Overlay ===== */
    .call-overlay {
    position: fixed; inset: 0; z-index: 3000;
    background: rgba(0,0,0,0.6);
    backdrop-filter: blur(8px);
    display: flex; align-items: center; justify-content: center;
    animation: fadeIn 0.3s ease;
    }
    .call-popup {
    background: var(--surface-elevated, #fff);
    border-radius: 28px; padding: 40px 36px 32px;
    text-align: center; min-width: 320px; max-width: 380px;
    box-shadow: 0 40px 80px rgba(0,0,0,0.4);
    animation: popupIn 0.35s cubic-bezier(0.4,0,0.2,1);
    }
    .call-pulsing-icon {
    width: 72px; height: 72px; border-radius: 50%;
    background: linear-gradient(135deg, #10b981, #34d399);
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 16px; font-size: 28px; color: #fff;
    animation: callPulse 1.5s infinite;
    }
    @@keyframes callPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(16,185,129,0.5); transform: scale(1); }
    50% { box-shadow: 0 0 0 24px rgba(16,185,129,0); transform: scale(1.05); }
    }
    .call-avatar {
    width: 80px; height: 80px; border-radius: 50%;
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 12px; font-size: 32px; font-weight: 700; color: #fff;
    }
    .call-name { font-size: 20px; font-weight: 700; color: #1e293b; margin-bottom: 4px; }
    .call-type-label { font-size: 14px; color: #64748b; margin-bottom: 28px; }
    .call-actions { display: flex; justify-content: center; gap: 32px; }
    .call-btn {
    width: 60px; height: 60px; border-radius: 50%; border: none;
    cursor: pointer; font-size: 24px; display: flex;
    align-items: center; justify-content: center;
    transition: all 0.25s cubic-bezier(0.4,0,0.2,1);
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
    }
    .call-btn:hover { transform: scale(1.1); }
    .call-btn:active { transform: scale(0.92); }
    .call-btn-accept { background: linear-gradient(135deg, #10b981, #34d399); color: #fff; }
    .call-btn-decline { background: linear-gradient(135deg, #ef4444, #dc2626); color: #fff; transform: rotate(135deg); }
    .call-btn-decline:hover { transform: rotate(135deg) scale(1.1); }
    /* Active Call Screen */
    .call-screen {
    width: 100%; max-width: 480px; height: 100vh; max-height: 800px;
    display: flex; flex-direction: column; position: relative;
    background: #0f172a; border-radius: 24px; overflow: hidden;
    box-shadow: 0 40px 80px rgba(0,0,0,0.5);
    }
    .call-video-container {
    flex: 1; position: relative; background: #1e293b;
    display: flex; align-items: center; justify-content: center;
    }
    #remoteVideo {
    width: 100%; height: 100%; object-fit: cover;
    }
    #localVideo {
    position: absolute; bottom: 20px; right: 20px;
    width: 120px; height: 160px; object-fit: cover;
    border-radius: 16px; border: 2px solid rgba(255,255,255,0.3);
    box-shadow: 0 8px 24px rgba(0,0,0,0.4);
    background: #334155;
    }
    .call-info {
    text-align: center; padding: 20px; background: linear-gradient(0deg, #0f172a, transparent);
    position: absolute; top: 0; left: 0; right: 0; z-index: 1;
    }
    .call-name-large { font-size: 22px; font-weight: 700; color: #fff; }
    .call-duration { font-size: 14px; color: rgba(255,255,255,0.6); margin-top: 4px; font-family: 'SF Mono', monospace; }
    .call-controls {
    display: flex; justify-content: center; gap: 24px;
    padding: 24px 20px; padding-bottom: calc(24px + env(safe-area-inset-bottom));
    background: #0f172a;
    }
    .call-ctrl-btn {
    width: 52px; height: 52px; border-radius: 50%; border: none;
    cursor: pointer; font-size: 20px; display: flex;
    align-items: center; justify-content: center;
    transition: all 0.2s; background: rgba(255,255,255,0.1); color: #fff;
    }
    .call-ctrl-btn:hover { background: rgba(255,255,255,0.2); transform: scale(1.05); }
    .call-ctrl-btn.active { background: #6366f1; color: #fff; }
    .call-ctrl-btn.muted { background: #ef4444; color: #fff; }
    .call-ctrl-btn-danger { background: #ef4444; color: #fff; width: 56px; height: 56px; font-size: 22px; }
    .call-ctrl-btn-danger:hover { background: #dc2626; }
    .call-screen.voice-only .call-video-container {
    background: linear-gradient(135deg, #1e1b4b, #312e81);
    }
    .call-screen.voice-only #remoteVideo,
    .call-screen.voice-only #localVideo { display: none; }
    .call-screen.voice-only::before {
    content: '\f2bd'; font-family: 'Font Awesome 6 Free'; font-weight: 900;
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -70%);
    font-size: 80px; color: rgba(255,255,255,0.08); z-index: 0;
    }
    @@media (max-width: 600px) {
    .call-screen { max-width: 100%; max-height: 100vh; border-radius: 0; }
    .call-popup { min-width: 280px; padding: 32px 24px 28px; }
    #localVideo { width: 90px; height: 120px; bottom: 12px; right: 12px; }
    }
        </style>

        <script>
            const callSenderId = parseInt('@User.FindFirstValue(ClaimTypes.NameIdentifier)');

            const callHub = new signalR.HubConnectionBuilder()
                .withUrl("/chatHub")
                .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
                .build();

            callHub.start().then(function () {
                callHub.invoke("RegisterUser", callSenderId).catch(console.error);
            }).catch(err => console.error("Call hub connection failed:", err));

            const rtcConfig = {
                iceServers: [
                    { urls: "stun:stun.l.google.com:19302" },
                    { urls: "stun:stun1.l.google.com:19302" }
                ]
            };

            let pc = null;
            let localStream = null;
            let pendingCandidates = [];
            let remoteDescSet = false;
            let currentCallType = null;
            let currentRemoteUserId = null;

            let pendingCallerId = null;
            let pendingCallerName = '';
            let pendingCallType = null;

            let callInProgress = false;
            let callTimerInterval = null;
            let callStartTime = null;

            function getInitials(name) {
                return (name || '?').substring(0, 1).toUpperCase();
            }

            function createPeerConnection() {
                pc = new RTCPeerConnection(rtcConfig);

                pc.ontrack = (event) => {
                    const remoteVideo = document.getElementById("remoteVideo");
                    if (remoteVideo && remoteVideo.srcObject !== event.streams[0]) {
                        remoteVideo.srcObject = event.streams[0];
                    }
                };

                pc.onicecandidate = (event) => {
                    if (event.candidate && currentRemoteUserId != null) {
                        callHub.invoke("SendIceCandidate", currentRemoteUserId, JSON.stringify(event.candidate));
                    }
                };

                pc.onconnectionstatechange = () => {
                    console.log("WebRTC state:", pc.connectionState);
                    if (pc.connectionState === "failed") cleanupCall();
                };

                return pc;
            }

            async function getLocalMedia(callType) {
                const constraints = { audio: true };
                if (callType === 'video') constraints.video = { width: { ideal: 640 }, height: { ideal: 480 }, facingMode: 'user' };
                const stream = await navigator.mediaDevices.getUserMedia(constraints);
                const localVideo = document.getElementById("localVideo");
                if (localVideo) localVideo.srcObject = stream;
                return stream;
            }

            function cleanupCall() {
                pc?.close();
                pc = null;
                remoteDescSet = false;
                pendingCandidates = [];
                currentRemoteUserId = null;
                currentCallType = null;
                callInProgress = false;
                if (callTimerInterval) {
                    clearInterval(callTimerInterval);
                    callTimerInterval = null;
                }
                localStream?.getTracks().forEach(t => t.stop());
                localStream = null;
                const remoteVideo = document.getElementById("remoteVideo");
                if (remoteVideo) remoteVideo.srcObject = null;
                const localVideo = document.getElementById("localVideo");
                if (localVideo) localVideo.srcObject = null;
                const activeOverlay = document.getElementById('activeCallOverlay');
                if (activeOverlay) activeOverlay.style.display = 'none';
                const incomingOverlay = document.getElementById('incomingCallOverlay');
                if (incomingOverlay) incomingOverlay.style.display = 'none';
            }

            async function flushPendingCandidates() {
                for (const c of pendingCandidates) {
                    try {
                        await pc.addIceCandidate(new RTCIceCandidate(c));
                    } catch (e) {
                        console.warn("Failed to add queued ICE candidate:", e);
                    }
                }
                pendingCandidates = [];
            }

            function showActiveCallScreen(type) {
                const incomingOverlay = document.getElementById('incomingCallOverlay');
                if (incomingOverlay) incomingOverlay.style.display = 'none';
                const activeOverlay = document.getElementById('activeCallOverlay');
                if (activeOverlay) activeOverlay.style.display = 'flex';

                const callScreen = document.querySelector('.call-screen');
                const videoContainer = document.querySelector('.call-video-container');
                if (callScreen && videoContainer) {
                    if (type === 'video') {
                        callScreen.classList.remove('voice-only');
                        videoContainer.style.display = 'flex';
                    } else {
                        callScreen.classList.add('voice-only');
                        videoContainer.style.display = 'flex';
                    }
                }
            }

            function startCallTimer() {
                let callSeconds = 0;
                const durationEl = document.getElementById('callDuration');
                if (durationEl) durationEl.textContent = '00:00';
                callTimerInterval = setInterval(() => {
                    callSeconds++;
                    const m = String(Math.floor(callSeconds / 60)).padStart(2, '0');
                    const s = String(callSeconds % 60).padStart(2, '0');
                    const durEl = document.getElementById('callDuration');
                    if (durEl) durEl.textContent = m + ':' + s;
                }, 1000);
            }

            function toggleMute() {
                if (!localStream) return;
                const audioTrack = localStream.getAudioTracks()[0];
                if (audioTrack) {
                    audioTrack.enabled = !audioTrack.enabled;
                    const btn = document.getElementById('callMuteBtn');
                    if (btn) btn.innerHTML = audioTrack.enabled ? '<i class="fas fa-microphone"></i>' : '<i class="fas fa-microphone-slash"></i>';
                }
            }

            function toggleVideo() {
                if (!localStream) return;
                const videoTrack = localStream.getVideoTracks()[0];
                if (!videoTrack) return;
                videoTrack.enabled = !videoTrack.enabled;
                const btn = document.getElementById('callVideoBtn');
                if (btn) btn.innerHTML = videoTrack.enabled ? '<i class="fas fa-video"></i>' : '<i class="fas fa-video-slash"></i>';
            }

            function toggleSpeaker() {
                const btn = document.getElementById('callSpeakerBtn');
                if (!btn) return;
                const isMuted = btn.classList.toggle('speaker-muted');
                const remoteVideoEl = document.getElementById('remoteVideo');
                if (remoteVideoEl) {
                    remoteVideoEl.muted = isMuted;
                }
                btn.innerHTML = isMuted ? '<i class="fas fa-volume-mute"></i>' : '<i class="fas fa-volume-up"></i>';
            }

            async function endCall() {
                await hangUp();
            }

            async function startCall(type, targetUserId, targetName) {
                if (callInProgress) return;
                if (callHub.state !== signalR.HubConnectionState.Connected) {
                    alert('Connecting... try again.');
                    return;
                }

                currentCallType = type;
                currentRemoteUserId = targetUserId;
                callInProgress = true;

                try {
                    localStream = await getLocalMedia(type);
                    showActiveCallScreen(type);
                    const nameEl = document.getElementById('activeCallName');
                    if (nameEl) nameEl.textContent = targetName || 'User';

                    createPeerConnection();
                    if (localStream) {
                        localStream.getTracks().forEach(track => {
                            if (pc) pc.addTrack(track, localStream);
                        });
                    }

                    await callHub.invoke("CallUser", targetUserId, type);
                } catch (err) {
                    console.error('startCall error:', err);
                    if (err.name === 'NotAllowedError') alert('Microphone/camera permission denied.');
                    else if (err.name === 'NotFoundError') alert('No camera/microphone found.');
                    else alert('Could not start call: ' + err.message);
                    cleanupCall();
                }
            }

            async function acceptCall() {
                if (!pendingCallerId) return;
                currentRemoteUserId = pendingCallerId;
                currentCallType = pendingCallType;
                callInProgress = true;
                const incomingOverlay = document.getElementById('incomingCallOverlay');
                if (incomingOverlay) incomingOverlay.style.display = 'none';
                try {
                    localStream = await getLocalMedia(pendingCallType);
                    showActiveCallScreen(pendingCallType);
                    createPeerConnection();
                    if (localStream) {
                        localStream.getTracks().forEach(track => {
                            if (pc) pc.addTrack(track, localStream);
                        });
                    }
                    await callHub.invoke("AnswerCall", pendingCallerId, true);
                } catch (err) {
                    console.error('acceptCall error:', err);
                    cleanupCall();
                }
            }

            async function declineCall() {
                const incomingOverlay = document.getElementById('incomingCallOverlay');
                if (incomingOverlay) incomingOverlay.style.display = 'none';
                await callHub.invoke("AnswerCall", pendingCallerId, false);
            }

            async function hangUp() {
                if (currentRemoteUserId != null) {
                    await callHub.invoke("EndCall", currentRemoteUserId);
                }
                cleanupCall();
            }

            callHub.on("IncomingCall", function (callerId, callerName, callerImage, type) {
                if (callInProgress) {
                    callHub.invoke("AnswerCall", callerId, false).catch(console.error);
                    return;
                }
                pendingCallerId = callerId;
                pendingCallerName = callerName;
                pendingCallType = type;

                const nameEl = document.getElementById('incomingCallName');
                if (nameEl) nameEl.textContent = callerName;
                const initialEl = document.getElementById('incomingCallInitial');
                if (initialEl) initialEl.textContent = getInitials(callerName);
                const typeEl = document.getElementById('incomingCallType');
                if (typeEl) typeEl.textContent = type === 'video' ? 'Incoming video call' : 'Incoming voice call';
                const overlay = document.getElementById('incomingCallOverlay');
                if (overlay) overlay.style.display = 'flex';
            });

            callHub.on("CallAccepted", async (remoteUserId, name) => {
                currentRemoteUserId = remoteUserId;
                const incomingOverlay = document.getElementById('incomingCallOverlay');
                if (incomingOverlay) incomingOverlay.style.display = 'none';
                try {
                    const offer = await pc.createOffer();
                    await pc.setLocalDescription(offer);
                    await callHub.invoke("SendOffer", remoteUserId, JSON.stringify(offer));
                    startCallTimer();
                } catch (e) {
                    console.error("Failed to create/send offer:", e);
                    cleanupCall();
                }
            });

            callHub.on("CallDeclined", (remoteUserId, reason) => {
                console.log("Call declined:", reason);
                cleanupCall();
                alert('Call declined.');
            });

            callHub.on("ReceiveOffer", async (sdpJson) => {
                try {
                    const offer = JSON.parse(sdpJson);
                    await pc.setRemoteDescription(new RTCSessionDescription(offer));
                    remoteDescSet = true;
                    await flushPendingCandidates();

                    const answer = await pc.createAnswer();
                    await pc.setLocalDescription(answer);
                    await callHub.invoke("SendAnswer", currentRemoteUserId, JSON.stringify(answer));
                    startCallTimer();
                } catch (e) {
                    console.error("Failed to handle offer:", e);
                    cleanupCall();
                }
            });

            callHub.on("ReceiveAnswer", async (sdpJson) => {
                try {
                    const answer = JSON.parse(sdpJson);
                    await pc.setRemoteDescription(new RTCSessionDescription(answer));
                    remoteDescSet = true;
                    await flushPendingCandidates();
                } catch (e) {
                    console.error("Failed to handle answer:", e);
                    cleanupCall();
                }
            });

            callHub.on("ReceiveIceCandidate", async (candidateJson) => {
                const candidate = JSON.parse(candidateJson);
                if (remoteDescSet && pc) {
                    try {
                        await pc.addIceCandidate(new RTCIceCandidate(candidate));
                    } catch (e) {
                        console.warn("addIceCandidate failed:", e);
                    }
                } else {
                    pendingCandidates.push(candidate);
                }
            });

            callHub.on("RemoteHangup", (senderId) => {
                cleanupCall();
                alert('Call ended by the other user.');
            });
        </script>
    }
</body>
</html>
